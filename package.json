{
  "name": "trusttools-desktop",
  "version": "3.0.1",
  "description": "AITracker local AI development asset dashboard",
  "private": true,
  "main": "build/electron/main.js",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:desktop": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm run build:electron && node electron/dev-runner.mjs",
    "dev:desktop:first-run": "node scripts/first-run-lab.mjs",
    "lab:first-run:prepare": "node scripts/first-run-lab.mjs --prepare-only",
    "lab:first-run:seed": "node scripts/first-run-lab.mjs --seed-only",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build && npm run build:electron",
    "build:dev": "vite build --mode development",
    "dist": "npm run build:desktop && electron-builder",
    "package:mac": "node scripts/package-mac.mjs",
    "dist:mac": "npm run package:mac",
    "dist:mac:x64": "npm run build:desktop && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "npm run build:desktop && electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:win:x64": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "postinstall": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:perf": "node --import tsx --test src/lib/local-usage/performance.test.ts && tsc --noEmit && eslint src/lib/local-usage",
    "check:i18n": "tsc --noEmit && node --import tsx --test src/lib/i18n/locale.test.ts src/lib/i18n/messages.test.ts src/lib/i18n/format.test.ts electron/i18n.test.ts electron/prefs.test.ts && node --import tsx scripts/check-translations.mjs && node scripts/check-hardcoded-text.mjs && node scripts/check-locale-sync.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:manifest": "node --import tsx scripts/generate-tool-manifest.mjs",
    "prebuild": "npm run generate:manifest",
    "verify:tool-registry": "npm run generate:manifest && node --import tsx scripts/verify-tool-registry.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-grid-layout": "1.5.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.7.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-grid-layout": "1.3.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "playwright": "1.62.0",
    "prettier": "^3.7.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  }
}
