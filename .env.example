# AITracker environment variables (all optional).
#
# Copy to `.env.local` for local overrides. Values shown are the defaults;
# the app runs without any of these set.

# Directory that holds the local-first SQLite database and user data.
# Defaults to the OS data directory (~/.aitracker). Tests and the first-run
# lab point this at throwaway temporary directories.
# AITRACKER_USAGE_HOME=

# Set to "false" to disable background collection/refresh tasks. The
# Playwright e2e web server sets this so runs stay deterministic.
# AITRACKER_ENABLE_BACKGROUND_TASKS=

# Dev server host/port used by `npm run dev:desktop` (Electron dev runner).
# AITRACKER_DEV_HOST=127.0.0.1
# AITRACKER_DEV_PORT=5173

# E2E only: set by playwright.config.empty-home.ts so specs can detect the
# empty-home scenario and skip otherwise.
# AITRACKER_E2E_EMPTY_HOME=

# Performance benchmark iteration count (scripts/performance/benchmark.mjs).
# PERF_RUNS=5

# Make `npm run verify:architecture` exit non-zero on findings, equivalent to
# `npm run verify:architecture:blocking`.
# ARCHITECTURE_VERIFY_BLOCKING=1
