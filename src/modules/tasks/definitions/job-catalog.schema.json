{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trusttools://tasks/job-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executorKey",
          "category",
          "defaultSchedule",
          "constraints",
          "startupPolicy",
          "retry",
          "timeoutMs",
          "queue",
          "network",
          "requiresApproval",
          "ui"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
          },
          "executorKey": {
            "enum": [
              "refresh-usage-v1",
              "refresh-skills-v1",
              "refresh-sessions-v1",
              "apply-retention-v1",
              "generate-report-v1"
            ]
          },
          "category": { "enum": ["collection", "maintenance", "report"] },
          "defaultSchedule": { "$ref": "#/$defs/schedule" },
          "constraints": { "$ref": "#/$defs/constraints" },
          "startupPolicy": { "enum": ["disabled", "always", "if-stale"] },
          "retry": { "$ref": "#/$defs/retry" },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000
          },
          "queue": { "enum": ["interactive", "background", "maintenance"] },
          "network": { "enum": ["forbidden", "allowed"] },
          "requiresApproval": { "type": "boolean" },
          "ui": {
            "type": "object",
            "additionalProperties": false,
            "required": ["settingsVisible", "i18nKey"],
            "properties": {
              "settingsVisible": { "type": "boolean" },
              "i18nKey": {
                "enum": [
                  "tasks.usageRefresh",
                  "tasks.skillsRefresh",
                  "tasks.sessionsRefresh",
                  "tasks.retentionApply",
                  "tasks.reportsGenerate"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minutes"],
          "properties": {
            "kind": { "const": "interval" },
            "minutes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "localTime"],
          "properties": {
            "kind": { "const": "daily" },
            "localTime": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "weekday", "localTime"],
          "properties": {
            "kind": { "const": "weekly" },
            "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
            "localTime": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minMinutes", "maxMinutes", "singleFlight"],
      "properties": {
        "minMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "singleFlight": { "type": "boolean" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "backoffSeconds"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "backoffSeconds": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 1, "maximum": 86400 }
        }
      }
    }
  }
}
