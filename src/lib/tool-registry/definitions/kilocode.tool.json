{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "kilocode",
  "display": {
    "name": "Kilo Code",
    "nameZh": "Kilo Code",
    "icon": "other",
    "color": "#eab308"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "Code/User/globalStorage/kilocode.kilo-code"
      },
      {
        "targets": [
          "windows10",
          "windows11"
        ],
        "base": "appDataRoaming",
        "path": "Code/User/globalStorage/kilocode.kilo-code"
      },
      {
        "targets": [
          "linux"
        ],
        "base": "configHome",
        "path": "Code/User/globalStorage/kilocode.kilo-code"
      },
      {
        "targets": [
          "linux"
        ],
        "base": "home",
        "path": ".vscode-server/data/User/globalStorage/kilocode.kilo-code"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
