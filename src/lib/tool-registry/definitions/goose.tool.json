{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "goose",
  "display": {
    "name": "Goose",
    "nameZh": "Goose",
    "icon": "https://goose-docs.ai/img/favicon.ico",
    "color": "#22c55e"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "linux"
        ],
        "base": "dataHome",
        "path": "goose"
      },
      {
        "targets": [
          "macos",
          "windows10",
          "windows11",
          "linux"
        ],
        "base": "home",
        "path": ".goose"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
