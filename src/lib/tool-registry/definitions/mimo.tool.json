{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "mimo",
  "display": {
    "name": "Mimo Code",
    "nameZh": "Mimo Code",
    "icon": "other",
    "color": "#ff6900"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "linux"
        ],
        "base": "dataHome",
        "path": "mimocode"
      },
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "orca/mimocode-hooks/shared/data"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
