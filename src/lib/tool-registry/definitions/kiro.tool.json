{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "kiro",
  "display": {
    "name": "Kiro",
    "nameZh": "Kiro",
    "icon": "other",
    "color": "#01a4ff"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "windows10",
          "windows11",
          "linux"
        ],
        "base": "home",
        "path": ".kiro"
      },
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "Kiro/User/globalStorage/kiro.kiroagent"
      },
      {
        "targets": [
          "windows10",
          "windows11"
        ],
        "base": "appDataRoaming",
        "path": "Kiro/User/globalStorage/kiro.kiroagent"
      },
      {
        "targets": [
          "linux"
        ],
        "base": "configHome",
        "path": "Kiro/User/globalStorage/kiro.kiroagent"
      },
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "kiro-cli"
      },
      {
        "targets": [
          "linux"
        ],
        "base": "dataHome",
        "path": "kiro-cli"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
