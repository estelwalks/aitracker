{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "workbuddy",
  "display": {
    "name": "WorkBuddy",
    "nameZh": "WorkBuddy",
    "icon": "https://codebuddy-1328495429.cos.accelerate.myqcloud.com/web/workbuddy/7c350554d6e526d96bb1d2ba32fd594611e9e711/assets/logo.svg",
    "color": "#22d3ee"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "windows10",
          "windows11",
          "linux"
        ],
        "base": "home",
        "path": ".workbuddy"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "native",
      "reader": "workbuddy-native",
      "paths": [
        {
          "targets": [
            "macos",
            "windows10",
            "windows11",
            "linux"
          ],
          "base": "home",
          "path": ".workbuddy/projects",
          "glob": "**/*.jsonl",
          "format": "jsonl"
        }
      ]
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
