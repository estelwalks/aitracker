{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "cline",
  "display": {
    "name": "Cline",
    "nameZh": "Cline",
    "icon": "other",
    "color": "#5b8def"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "Code/User/globalStorage/saoudrizwan.claude-dev"
      },
      {
        "targets": [
          "macos",
          "linux"
        ],
        "base": "configHome",
        "path": "Code/User/globalStorage/saoudrizwan.claude-dev"
      },
      {
        "targets": [
          "windows10",
          "windows11"
        ],
        "base": "appDataRoaming",
        "path": "Code/User/globalStorage/saoudrizwan.claude-dev"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "adapter",
      "reader": "generic-json",
      "paths": [
        {
          "targets": [
            "macos"
          ],
          "base": "appData",
          "path": "Code/User/globalStorage/saoudrizwan.claude-dev/tasks",
          "glob": "**/*.json",
          "format": "json"
        },
        {
          "targets": [
            "macos",
            "linux"
          ],
          "base": "configHome",
          "path": "Code/User/globalStorage/saoudrizwan.claude-dev/tasks",
          "glob": "**/*.json",
          "format": "json"
        },
        {
          "targets": [
            "windows10",
            "windows11"
          ],
          "base": "appDataRoaming",
          "path": "Code/User/globalStorage/saoudrizwan.claude-dev/tasks",
          "glob": "**/*.json",
          "format": "json"
        }
      ]
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
