{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "opencode",
  "display": {
    "name": "OpenCode",
    "nameZh": "OpenCode"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "linux"
        ],
        "base": "configHome",
        "path": "opencode"
      },
      {
        "targets": [
          "macos",
          "linux"
        ],
        "base": "dataHome",
        "path": "opencode"
      }
    ]
  },
  "storage": {
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".config/opencode/skills"
        }
      ],
      "markers": [
        "SKILL.md",
        "skill.md"
      ],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "adapter",
      "reader": "generic",
      "paths": [
        {
          "targets": [
            "macos",
            "linux"
          ],
          "base": "dataHome",
          "path": "opencode/storage/message",
          "glob": "**/*.json",
          "format": "json"
        },
        {
          "targets": [
            "macos",
            "windows10",
            "windows11",
            "linux"
          ],
          "base": "home",
          "path": ".opencode",
          "glob": "**/*.jsonl",
          "format": "jsonl"
        }
      ]
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "pricing": {
    "billingMode": "api-metered",
    "fallbackProfileRef": "unpriced-v1",
    "rulePackRefs": []
  }
}
