{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "gemini-cli",
  "display": {
    "name": "Gemini CLI",
    "nameZh": "Gemini CLI",
    "icon": "other",
    "color": "#4285f4"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "windows10",
          "windows11",
          "linux"
        ],
        "base": "home",
        "path": ".gemini/tmp"
      }
    ],
    "executable": {
      "shared": [
        "gemini"
      ]
    }
  },
  "storage": {
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".gemini/skills"
        }
      ],
      "markers": [
        "SKILL.md",
        "skill.md"
      ],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "native",
      "reader": "gemini-session-v1",
      "maxFileSizeBytes": 67108864,
      "paths": [
        {
          "targets": [
            "macos",
            "windows10",
            "windows11",
            "linux"
          ],
          "base": "home",
          "path": ".gemini/tmp",
          "glob": "**/chats/session-*.json",
          "format": "json"
        }
      ]
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
