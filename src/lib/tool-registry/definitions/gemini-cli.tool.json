{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "gemini-cli",
  "display": {
    "name": "Gemini CLI",
    "nameZh": "Gemini CLI"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": ["macos", "windows10", "windows11", "linux"],
        "base": "home",
        "path": ".gemini"
      }
    ]
  },
  "storage": {
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".gemini/skills"
        }
      ],
      "markers": ["SKILL.md", "skill.md"],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "adapter",
      "reader": "generic",
      "paths": [
        {
          "targets": ["macos", "windows10", "windows11", "linux"],
          "base": "home",
          "path": ".gemini/tmp",
          "glob": "**/chats/*.json",
          "format": "json"
        },
        {
          "targets": ["macos", "windows10", "windows11", "linux"],
          "base": "home",
          "path": ".gemini",
          "glob": "**/*usage*.jsonl",
          "format": "jsonl"
        }
      ]
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
