{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "zed",
  "display": {
    "name": "Zed Agent",
    "nameZh": "Zed Agent"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": ["macos"],
        "base": "appData",
        "path": "Zed"
      },
      {
        "targets": ["macos", "linux"],
        "base": "dataHome",
        "path": "zed"
      }
    ]
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "unsupported",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "unsupported",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
