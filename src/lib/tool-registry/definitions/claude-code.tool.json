{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "claude-code",
  "display": {
    "name": "Claude Code",
    "nameZh": "Claude Code",
    "icon": "claude",
    "color": "#d97757"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": [
          "macos",
          "windows10",
          "windows11",
          "linux"
        ],
        "base": "home",
        "path": ".claude"
      },
      {
        "targets": [
          "macos"
        ],
        "base": "appData",
        "path": "Claude"
      }
    ],
    "executable": {
      "shared": [
        "claude"
      ]
    }
  },
  "storage": {
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".claude/skills"
        }
      ],
      "markers": [
        "SKILL.md",
        "skill.md"
      ],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "native",
      "reader": "claude-rollout-v1",
      "paths": [
        {
          "targets": [
            "macos",
            "windows10",
            "windows11",
            "linux"
          ],
          "base": "home",
          "path": ".claude/projects",
          "glob": "**/*.jsonl",
          "format": "jsonl"
        }
      ]
    },
    "context": {
      "mode": "native",
      "reader": "claude-context-v1",
      "dimensions": [
        "tools",
        "skills",
        "commands",
        "mcp",
        "toolOutputs"
      ]
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "resume",
      "reader": "claude-session-v1",
      "command": [
        "claude",
        "--resume",
        "{sessionId}"
      ]
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
