{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "antigravity",
  "display": {
    "name": "Antigravity",
    "nameZh": "Antigravity"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": ["macos", "windows10", "windows11", "linux"],
        "base": "home",
        "path": ".gemini/antigravity"
      },
      {
        "targets": ["macos"],
        "base": "appData",
        "path": "Antigravity"
      }
    ]
  },
  "storage": {
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".gemini/antigravity/skills"
        },
        {
          "base": "home",
          "path": ".gemini/antigravity-ide/skills"
        }
      ],
      "markers": ["SKILL.md", "skill.md"],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "unsupported"
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "unsupported"
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
